# =============================================================================
# PARKFLOW ENVIRONMENT VARIABLES (.env.example)
# =============================================================================

# Flask Application Secret Key
SECRET_KEY=parkflow-super-secret-key-change-in-production

# Database Connection URL
# For local testing, leave empty to automatically use SQLite (parkflow.db)
# For production on Vercel, connect a Neon PostgreSQL or Vercel Postgres database:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Port for local server (default: 5000)
PORT=5000
